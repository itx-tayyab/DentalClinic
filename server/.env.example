# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/dental_clinic?schema=public"

# Secrets: generate with `openssl rand -hex 32`
ACCESS_TOKEN_SECRET="replace-with-a-long-random-string"
REFRESH_TOKEN_SECRET="replace-with-a-different-long-random-string"

# Server
PORT=8000
CORS_ORIGIN="http://localhost:3000"

# Clinic display time zone (IANA name, used by the dashboard)
CLINIC_TIMEZONE="Asia/Karachi"
