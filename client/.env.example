# Copy to .env.local for local development. Never commit .env.local.
# Base URL of the NestJS API, read only on the Next.js server.
API_BASE_URL="http://localhost:8000"

# IANA time zone used to decide what "today" means.
CLINIC_TIMEZONE="Asia/Karachi"

# Port for `next start` / the standalone server.
PORT=3000
