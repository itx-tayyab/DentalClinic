# Server-only values. Copy to .env.local (never commit it).
# Do NOT prefix these with NEXT_PUBLIC_: they must never reach the browser.

# IANA time zone used to decide what "today" means.
DASHBOARD_TIMEZONE="Asia/Karachi"

# n8n webhook that returns today's Google Calendar events.
N8N_APPOINTMENTS_URL="https://your-n8n.example.com/webhook/appointments"

# Shared secret sent to n8n as the x-dashboard-key header.
N8N_DASHBOARD_KEY="replace-with-the-webhook-shared-secret"

# Password required by the dashboard login gate.
DASHBOARD_PASSWORD="replace-with-a-strong-password"

# Use fixtures/appointments.json instead of calling n8n.
DASHBOARD_USE_FIXTURES="false"
